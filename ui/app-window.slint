// Uncomment these once your font files are in the fonts/ directory:
// import "fonts/jost-regular.ttf";
// import "fonts/lexend-regular.ttf";

global Assets {
    out property <image> icon: @image-url("assets/image-3002a627b00fabe5.svg");
}

component Settings inherits Rectangle {
    callback clicked <=> touch.clicked;

    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: touch.has-hover ? #00000010 : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    Image {
        width: 20px;
        height: 20px;
        image-fit: contain;
        source: Assets.icon;
    }
}

export component AppWindow inherits Window {
    in-out property <bool> protection-enabled: true;
    in-out property <int> alert-count: 0;
    in-out property <string> alert-text: "No threats detected";
    callback settings-clicked();

    title: "Vanti";
    width: 308px;
    height: 556px;
    background: #ffffff88;

    Rectangle {
        x: 0px;
        y: 12px;
        width: 308px;
        height: 556px;
        background: #FFFFFFF0;
        border-radius: 16px;
        drop-shadow-color: #00000040;
        drop-shadow-blur: 18.4px;
        drop-shadow-offset-y: 4px;

        VerticalLayout {
            padding-bottom: 24px;
            padding-left: 27px;
            padding-right: 27px;
            spacing: 16px;

            // Top Status Card ("Vanti is...")
            Rectangle {
                height: 190px;
                background: #FFFFFFA6;
                border-width: 2px;
                border-color: #00000017;
                border-radius: 20px;

                VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    Text {
                        text: "Vanti is...";
                        color: #000000;
                        font-family: "Jost";
                        font-size: 20px;
                        horizontal-alignment: center;
                    }

                    // Interactive On/Off Pill Button
                    Rectangle {
                        width: 168px;
                        height: 57px;
                        x: (parent.width - self.width) / 2;
                        background: root.protection-enabled ? #8DFF83 : #E0E0E0;
                        border-width: 2px;
                        border-color: #00000059;
                        border-radius: 28.5px;

                        animate background { duration: 150ms; }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.protection-enabled = !root.protection-enabled;
                            }
                        }

                        Text {
                            text: root.protection-enabled ? "On" : "Off";
                            color: #000000;
                            font-family: "Lexend";
                            font-size: 32px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Centered Settings Icon
                    HorizontalLayout {
                        alignment: center;
                        Settings {
                            clicked => {
                                root.settings-clicked();
                            }
                        }
                    }
                }
            }

            // Bottom Alerts Card
            Rectangle {
                vertical-stretch: 1;
                background: #FFFFFFA6;
                border-width: 2px;
                border-color: #00000017;
                border-radius: 20px;

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Alerts";
                            color: #000000;
                            font-family: "Jost";
                            font-size: 20px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.alert-count;
                            color: #FF0000;
                            font-family: "Jost";
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // Dynamic Alert Pill
                    Rectangle {
                        height: 37px;
                        background: #FFFFFF;
                        border-width: 1px;
                        border-color: #00000026;
                        border-radius: 18.5px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            spacing: 8px;

                            Text {
                                text: root.alert-text;
                                color: #000000;
                                font-family: "Jost";
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Rectangle {
                                width: 23px;
                                height: 23px;
                                y: (parent.height - self.height) / 2;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: @image-url("assets/image-89526c33a764d226.svg");
                                    image-fit: contain;
                                }

                                Image {
                                    width: 15px;
                                    height: 15px;
                                    x: 4px;
                                    y: 4px;
                                    source: @image-url("assets/image-4818b908f95360e4.png");
                                    image-fit: cover;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}